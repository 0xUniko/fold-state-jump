{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "bun: dev",
      "type": "process",
      "command": "bun",
      "args": [
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "bun",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\$ bun .*--watch.*$",
          "endsPattern": ".*Bundled [0-9]+ modules? in [0-9]+ms.*"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
