{
  "name": "fold-state-jump",
  "displayName": "Fold State Jump",
  "description": "Trace fold-state values back to previous mutations through supported C++ call paths.",
  "version": "0.2.0",
  "publisher": "0xuniko",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "C++",
    "ranges",
    "fold_left",
    "data flow",
    "clang",
    "effect-ts",
    "bun"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:cpp",
    "onLanguage:c"
  ],
  "contributes": {
    "commands": [
      {
        "command": "foldStateJump.jumpToPreviousMutation",
        "title": "Fold State Jump: Go to Previous State Mutation"
      }
    ],
    "keybindings": [
      {
        "command": "foldStateJump.jumpToPreviousMutation",
        "key": "ctrl+alt+shift+m",
        "mac": "cmd+alt+shift+m",
        "when": "editorTextFocus && (editorLangId == cpp || editorLangId == c || editorLangId == cuda-cpp || editorLangId == objective-cpp)"
      }
    ],
    "configuration": {
      "title": "Fold State Jump",
      "properties": {
        "foldStateJump.clangPath": {
          "type": "string",
          "default": "clang++",
          "description": "Path to clang++."
        },
        "foldStateJump.maxAstBytes": {
          "type": "number",
          "default": 536870912,
          "minimum": 1048576,
          "maximum": 1073741824,
          "description": "Safety limit for streamed Clang JSON AST output in bytes. Larger ASTs still require substantial memory to parse."
        },
        "foldStateJump.compileCommandsPath": {
          "type": "string",
          "default": "",
          "description": "Path to compile_commands.json, absolute or relative to the first workspace folder. When empty, standard project and build directories are searched."
        }
      }
    }
  },
  "scripts": {
    "dev": "bun run build --watch",
    "build": "bun build ./src/extension.ts --target=node --format=cjs --external vscode --sourcemap=external --outfile ./dist/extension.js",
    "package": "bun run build && bunx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^4.0.0"
  },
  "dependencies": {
    "effect": "^4.0.5"
  }
}
